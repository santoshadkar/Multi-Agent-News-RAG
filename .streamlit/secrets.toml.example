# Copy to .streamlit/secrets.toml for LOCAL Streamlit testing of the
# st.secrets fallback path (never commit the real secrets.toml -- it's
# gitignored). On Streamlit Community Cloud, you don't create this file at
# all: paste the same keys into your app's Settings -> Secrets box in the
# web UI instead, in this same TOML format.

COHERE_API_KEY = "your-cohere-key-here"
# NEWSAPI_KEY = ""
# GNEWS_KEY = ""
